---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  title: string;
}
const { headings, title } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{items.length > 1 && (
  <nav class="toc" aria-label={title}>
    <p class="label title-font">{title}</p>
    <ul>
      {items.map((h) => (
        <li class={`d${h.depth}`}><a href={`#${h.slug}`} data-toc-link>{h.text}</a></li>
      ))}
    </ul>
  </nav>
)}

<style>
  .toc { font-size: 0.84rem; }
  .label { margin: 0 0 10px; padding-bottom: 6px; border-bottom: 3px double var(--line-strong); font-size: 1rem; letter-spacing: 0.15em; }
  ul { margin: 0; padding: 0; list-style: none; }
  li a {
    display: block;
    padding: 3px 0 3px 12px;
    border-left: 2px solid transparent;
    color: var(--ink-muted);
    text-decoration: none;
    line-height: 1.5;
  }
  li.d3 a { padding-left: 24px; font-size: 0.95em; }
  li a:hover { color: var(--ink); }
  li a.active { color: var(--vermilion); border-left-color: var(--vermilion); }
</style>
