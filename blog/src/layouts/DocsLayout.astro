---
/**
 * 문서 사이트형 레이아웃 (집현전 테마)
 * 현판 헤더 + 단청 띠 / 왼쪽 서고(폴더 트리) / 가운데 서책(본문) / 오른쪽 목차
 */
import '@fontsource/song-myung';
import '@fontsource-variable/noto-serif-kr';
import '@fontsource-variable/jetbrains-mono';
import '@/styles/global.css';
import type { MarkdownHeading } from 'astro';
import SidebarTree from '@/components/SidebarTree.astro';
import Toc from '@/components/Toc.astro';
import { buildTree, getBlog, getNotes } from '@/lib/notes';
import { withBase } from '@/lib/slug';

interface Props {
  title?: string;
  description?: string;
  currentId?: string;
  currentPath?: string;
  headings?: MarkdownHeading[];
}

const { title, description, currentId, currentPath, headings = [] } = Astro.props;
const blog = await getBlog();
const tree = buildTree(await getNotes());
const pageTitle = title ? `${title} | ${blog.title}` : `${blog.title} ${blog.hanja ?? ''} | ${blog.brand}`;
const external = (href: string) => /^https?:/.test(href);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? blog.description} />
    <meta property="og:title" content={pageTitle} />
    <meta name="theme-color" content="#3a2618" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-inner">
        <button class="menu-btn" type="button" aria-controls="sidebar" aria-expanded="false" data-menu-toggle>
          <span aria-hidden="true">☰</span><span class="sr-only">{blog.labels.menu}</span>
        </button>
        <a class="plaque title-font" href={withBase()}>
          <span class="plaque-hanja">{blog.hanja ?? blog.title}</span>
          {blog.hanja && <span class="plaque-ko">{blog.title}</span>}
        </a>
        <nav class="top-nav">
          {blog.nav.map((l) => (
            <a href={l.href} {...(external(l.href) && { target: '_blank', rel: 'noopener' })}>{l.label}</a>
          ))}
        </nav>
      </div>
      <div class="dancheong" aria-hidden="true"></div>
    </header>

    <div class="shell">
      <aside class="sidebar" id="sidebar">
        <nav aria-label={blog.labels.library}>
          <a class:list={['home-link', { active: !currentId }]} href={withBase()}>{blog.labels.home}</a>
          <p class="library title-font">{blog.labels.library}</p>
          <SidebarTree nodes={tree} currentId={currentId} currentPath={currentPath} />
        </nav>
        {blog.sidebarLinks.length > 0 && (
          <ul class="extra">
            {blog.sidebarLinks.map((l) => (
              <li><a href={l.href} target="_blank" rel="noopener">{l.label}</a></li>
            ))}
          </ul>
        )}
      </aside>
      <div class="backdrop" data-menu-close></div>

      <main class="main">
        <slot />
      </main>

      <aside class="toc-col">
        <div class="toc-sticky"><Toc headings={headings} title={blog.labels.toc} /></div>
      </aside>
    </div>

    <script>
      // 모바일 사이드바 열기/닫기
      const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const setOpen = (open: boolean) => {
        document.body.classList.toggle('menu-open', open);
        btn?.setAttribute('aria-expanded', String(open));
      };
      btn?.addEventListener('click', () => setOpen(!document.body.classList.contains('menu-open')));
      document.querySelector('[data-menu-close]')?.addEventListener('click', () => setOpen(false));
      document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));

      // 현재 글이 사이드바에 보이도록 스크롤
      // (scrollIntoView는 페이지 전체까지 스크롤하므로 사이드바만 직접 스크롤)
      const sidebar = document.querySelector<HTMLElement>('.sidebar');
      const active = sidebar?.querySelector<HTMLElement>('.leaf.active');
      if (sidebar && active) {
        const top = active.getBoundingClientRect().top - sidebar.getBoundingClientRect().top;
        sidebar.scrollTop += top - sidebar.clientHeight / 2;
      }

      // 목차: 지금 읽는 위치 강조
      const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
      if (links.length) {
        const targets = links
          .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
          .filter((el): el is HTMLElement => !!el);
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              links.forEach((a) => a.classList.toggle('active', decodeURIComponent(a.hash.slice(1)) === e.target.id));
            }
          },
          { rootMargin: '-80px 0px -70% 0px' },
        );
        targets.forEach((t) => io.observe(t));
      }
    </script>
  </body>
</html>

<style>
  /* ---------- 현판 헤더 ---------- */
  .topbar {
    position: sticky;
    top: 0;
    z-index: 30;
    background: linear-gradient(180deg, #4a3220, var(--wood));
    box-shadow: 0 2px 10px rgb(58 38 24 / 0.35);
  }
  .topbar-inner { display: flex; align-items: center; gap: 14px; height: var(--topbar-h); padding: 0 16px; }
  .dancheong { height: 7px; background: var(--dancheong); border-top: 1px solid var(--gold); border-bottom: 1px solid #2a1b10; }

  .plaque {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    padding: 3px 16px 4px;
    border: 2px solid var(--gold);
    outline: 1px solid rgb(176 141 74 / 0.45);
    outline-offset: 3px;
    background: #2a1b10;
    color: #e6c77f;
    text-decoration: none;
    line-height: 1.3;
  }
  .plaque-hanja { font-size: 1.35rem; letter-spacing: 0.18em; }
  .plaque-ko { font-size: 0.85rem; color: #cdb98d; letter-spacing: 0.1em; }
  .plaque:hover .plaque-hanja { color: #f3d996; }

  .top-nav { display: flex; gap: 20px; margin-left: auto; }
  .top-nav a { color: #e9dcc0; text-decoration: none; font-size: 0.9rem; }
  .top-nav a:hover { color: #f3d996; }
  .menu-btn {
    display: none;
    padding: 2px 10px;
    border: 1px solid var(--gold);
    border-radius: var(--radius);
    background: transparent;
    color: #e6c77f;
    font-size: 1rem;
    cursor: pointer;
  }

  /* ---------- 배치 ---------- */
  .shell {
    display: grid;
    grid-template-columns: var(--sidebar-w) minmax(0, 1fr) 220px;
    max-width: 1440px;
    margin: 0 auto;
  }
  .sidebar {
    position: sticky;
    top: calc(var(--topbar-h) + 9px);
    height: calc(100vh - var(--topbar-h) - 9px);
    overflow-y: auto;
    padding: 22px 12px 40px 16px;
    background: rgb(235 224 198 / 0.55);
    border-right: 1px solid var(--line);
    scrollbar-width: thin;
  }
  .home-link {
    display: block;
    padding: 5px 10px;
    border-left: 2px solid transparent;
    font-size: 0.92rem;
    color: var(--ink-muted);
    text-decoration: none;
  }
  .home-link:hover { color: var(--vermilion); }
  .home-link.active { color: var(--vermilion); border-left-color: var(--vermilion); background: var(--vermilion-soft); }
  .library {
    margin: 18px 0 8px;
    padding: 0 10px 6px;
    border-bottom: 1px solid var(--line);
    font-size: 1rem;
    color: var(--ink);
    letter-spacing: 0.08em;
  }
  .extra { margin: 20px 0 0; padding: 14px 0 0; list-style: none; border-top: 1px solid var(--line); }
  .extra a { display: block; padding: 4px 10px; font-size: 0.85rem; color: var(--ink-muted); text-decoration: none; }
  .extra a:hover { color: var(--vermilion); }

  .main { min-width: 0; padding: 40px clamp(12px, 4vw, 48px) 96px; }
  .toc-col { padding: 48px 16px 0 0; }
  .toc-sticky { position: sticky; top: calc(var(--topbar-h) + 40px); max-height: calc(100vh - var(--topbar-h) - 72px); overflow-y: auto; }
  .backdrop { display: none; }

  @media (max-width: 1200px) {
    .shell { grid-template-columns: var(--sidebar-w) minmax(0, 1fr); }
    .toc-col { display: none; }
  }
  @media (max-width: 860px) {
    .menu-btn { display: inline-block; }
    .plaque-ko { display: none; }
    .top-nav { gap: 14px; }
    .top-nav a { font-size: 0.82rem; }
    .shell { display: block; }
    .sidebar {
      position: fixed;
      z-index: 25;
      left: 0;
      top: calc(var(--topbar-h) + 9px);
      width: min(300px, 85vw);
      background: var(--paper);
      transform: translateX(-100%);
      transition: transform 0.25s var(--ease-out);
    }
    :global(body.menu-open) .sidebar { transform: none; box-shadow: 8px 0 24px rgb(58 38 24 / 0.25); }
    :global(body.menu-open) .backdrop {
      display: block;
      position: fixed;
      inset: calc(var(--topbar-h) + 9px) 0 0 0;
      z-index: 20;
      background: rgb(42 34 27 / 0.35);
    }
    .main { padding: 20px 10px 72px; }
  }
</style>
