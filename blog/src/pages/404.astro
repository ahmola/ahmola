---
import DocsLayout from '@/layouts/DocsLayout.astro';
import { getBlog } from '@/lib/notes';
import { withBase } from '@/lib/slug';

const blog = await getBlog();
---

<DocsLayout title={blog.labels.notFound}>
  <article class="prose">
    <p class="mono accent">ERR 404</p>
    <h1>{blog.labels.notFound}</h1>
    <p><a href={withBase()}>{blog.labels.backHome}</a></p>
  </article>
</DocsLayout>
