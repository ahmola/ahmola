---
/**
 * 노트 페이지: notes/<경로>.md → /blog/<경로>/
 */
import { render } from 'astro:content';
import DocsLayout from '@/layouts/DocsLayout.astro';
import { fileTitle, getBlog, getNotes, isHome, sourcePath, sourceUrl, type Note } from '@/lib/notes';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.filter((n) => !isHome(n)).map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props as { note: Note };
const blog = await getBlog();
const { Content, headings } = await render(note);
const path = sourcePath(note);
const h1 = headings.find((h) => h.depth === 1)?.text;
const title = note.data.title ?? h1 ?? fileTitle(note);
const crumbs = path.split('/').slice(0, -1);
---

<DocsLayout title={title} currentId={note.id} currentPath={path} headings={headings}>
  <div class="book">
  {crumbs.length > 0 && (
    <p class="crumbs">
      {crumbs.map((c, i) => (<>{i > 0 && <span class="sep">/</span>}<span>{c}</span></>))}
    </p>
  )}
  <article class="prose">
    {!h1 && <h1>{title}</h1>}
    <Content />
  </article>
  <p class="source">
    <a href={sourceUrl(note)} target="_blank" rel="noopener">
      {blog.labels.viewSource} ↗
    </a>
  </p>
  </div>
</DocsLayout>
