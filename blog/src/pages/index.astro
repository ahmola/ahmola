---
/**
 * 블로그 홈: ComputerScience 저장소의 README.md 를 그대로 보여줍니다.
 */
import { render } from 'astro:content';
import DocsLayout from '@/layouts/DocsLayout.astro';
import { getBlog, getNotes, isHome, sourcePath } from '@/lib/notes';

const blog = await getBlog();
const home = (await getNotes()).find(isHome);
const rendered = home ? await render(home) : null;
---

<DocsLayout description={blog.description} headings={rendered?.headings}>
  <article class="prose">
    {rendered ? <rendered.Content /> : <h1>{blog.title}</h1>}
  </article>
  {home && (
    <p class="source mono">
      <a href={`${blog.sourceRepo}/blob/${blog.sourceBranch}/${sourcePath(home)}`} target="_blank" rel="noopener">
        {blog.labels.viewSource} ↗
      </a>
    </p>
  )}
</DocsLayout>
