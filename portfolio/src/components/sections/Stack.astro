---
import Section from '@/components/Section.astro';
import { getSite, getStack } from '@/lib/content';

const { stack } = await getSite();
const categories = await getStack();
---

<Section id="stack" title={stack.title} description={stack.description}>
  <div class="grid">
    {categories.map((c) => (
      <div class="group">
        <h3 class="mono">{c.title}</h3>
        <ul class="tag-list">
          {c.items.map((item) => <li class="tag">{item}</li>)}
        </ul>
      </div>
    ))}
  </div>
</Section>

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 24px; }
  h3 { margin: 0 0 12px; font-size: 0.95rem; color: var(--color-muted); font-weight: 600; }
</style>
