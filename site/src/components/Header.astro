---
import { resolveHref } from '@/lib/url';

interface Props {
  brand: string;
  nav: { label: string; href: string }[];
}

const { brand, nav } = Astro.props;
---

<header class="header">
  <div class="container inner">
    <a class="brand mono" href={resolveHref('/')}>{brand}</a>
    <nav aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li><a href={resolveHref(item.href)}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--color-bg) 85%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 60px;
  }
  .brand { font-weight: 700; text-decoration: none; white-space: nowrap; }
  ul { display: flex; gap: 20px; margin: 0; padding: 0; list-style: none; }
  nav a { text-decoration: none; color: var(--color-muted); font-size: 0.95rem; }
  nav a:hover { color: var(--color-accent); }
  @media (max-width: 560px) {
    ul { gap: 12px; }
    nav a { font-size: 0.85rem; }
  }
</style>
