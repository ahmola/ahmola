---
import { resolveHref } from '@/lib/url';

interface Props {
  brand: string;
  nav: { label: string; href: string }[];
}

const { brand, nav } = Astro.props;
---

<header class="header">
  <div class="container inner">
    <a class="brand mono" href={resolveHref('/')}>
      <span class="accent">~/</span>{brand}
    </a>
    <nav aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li>
            <a class="mono" href={resolveHref(item.href)} data-nav-link={item.href.startsWith('#') ? '' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgb(4 7 5 / 0.72);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 60px;
  }
  .brand { font-weight: 700; text-decoration: none; white-space: nowrap; }
  ul { display: flex; gap: 22px; margin: 0; padding: 0; list-style: none; }
  nav a {
    position: relative;
    text-decoration: none;
    color: var(--color-muted);
    font-size: 0.85rem;
    transition: color 0.2s;
  }
  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease-out);
  }
  nav a:hover,
  nav a.is-active { color: var(--color-accent); }
  nav a:hover::after,
  nav a.is-active::after { transform: scaleX(1); }
  @media (max-width: 560px) {
    ul { gap: 12px; }
    nav a { font-size: 0.75rem; }
  }
</style>
