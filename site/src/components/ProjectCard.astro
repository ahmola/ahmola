---
import type { CollectionEntry } from 'astro:content';
import { resolveHref } from '@/lib/url';

interface Props {
  project: CollectionEntry<'projects'>;
  detailLabel: string;
}
const { project, detailLabel } = Astro.props;
const { title, summary, period, stack } = project.data;
---

<article class="card">
  <a class="link" href={resolveHref(`/projects/${project.id}/`)}>
    {period && <p class="period mono muted">{period}</p>}
    <h3>{title}</h3>
    <p class="muted">{summary}</p>
    {stack.length > 0 && (
      <ul class="tag-list">
        {stack.map((s) => <li class="tag">{s}</li>)}
      </ul>
    )}
    <span class="more">{detailLabel} →</span>
  </a>
</article>

<style>
  .card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    transition: border-color 0.15s;
  }
  .card:hover { border-color: var(--color-accent); }
  .link { display: flex; flex-direction: column; gap: 10px; height: 100%; padding: 24px; text-decoration: none; }
  h3 { margin: 0; font-size: 1.15rem; }
  p { margin: 0; }
  .period { font-size: 0.8rem; }
  .more { margin-top: auto; padding-top: 8px; font-weight: 600; color: var(--color-accent); font-size: 0.9rem; }
</style>
