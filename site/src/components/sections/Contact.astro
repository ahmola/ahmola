---
import Section from '@/components/Section.astro';
import { getSite } from '@/lib/content';
import { isExternal } from '@/lib/url';

interface Props { index?: number }
const { index } = Astro.props;
const { contact } = await getSite();
---

<Section id="contact" title={contact.title} description={contact.description} index={index}>
  <ul class="links" data-reveal>
    {contact.links.map((l) => (
      <li>
        <a class="button" href={l.href} {...(isExternal(l.href) && { target: '_blank', rel: 'noopener' })}>
          <span class="accent">&gt;</span> {l.label}
        </a>
      </li>
    ))}
  </ul>
</Section>

<style>
  .links { display: flex; flex-wrap: wrap; gap: 12px; margin: 0 0 var(--space-section); padding: 0; list-style: none; }
</style>
