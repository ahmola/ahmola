---
import Section from '@/components/Section.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { getSite, getProjects } from '@/lib/content';

const { projects: copy } = await getSite();
const projects = await getProjects();
---

<Section id="projects" title={copy.title} description={copy.description}>
  {projects.length === 0 ? (
    <p class="muted">{copy.emptyText}</p>
  ) : (
    <div class="grid">
      {projects.map((p) => <ProjectCard project={p} detailLabel={copy.labels.detail} />)}
    </div>
  )}
</Section>

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
</style>
