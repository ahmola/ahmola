---
/**
 * 섹션 공통 틀: id(메뉴 앵커), 제목, 설명 + 내용(slot)
 */
interface Props {
  id: string;
  title: string;
  description?: string;
}
const { id, title, description } = Astro.props;
---

<section id={id} class="section">
  <div class="container">
    <h2 class="title">{title}</h2>
    {description && <p class="muted desc">{description}</p>}
    <div class="body">
      <slot />
    </div>
  </div>
</section>

<style>
  .section { padding: var(--space-section) 0 0; }
  .title { margin: 0; font-size: 1.75rem; letter-spacing: -0.01em; }
  .desc { margin: 8px 0 0; }
  .body { margin-top: 32px; }
</style>
