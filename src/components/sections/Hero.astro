---
import { getSite } from '@/lib/content';
import { resolveHref, isExternal } from '@/lib/url';

const { hero } = await getSite();
---

<section class="hero">
  <div class="container">
    <p class="eyebrow mono">{hero.eyebrow}</p>
    <h1>{hero.name}</h1>
    <p class="tagline">{hero.tagline}</p>
    {hero.quote && <blockquote class="muted">“{hero.quote}”</blockquote>}
    {hero.actions.length > 0 && (
      <div class="actions">
        {hero.actions.map((a, i) => (
          <a
            class:list={['button', { primary: i === 0 }]}
            href={resolveHref(a.href)}
            {...(isExternal(a.href) && { target: '_blank', rel: 'noopener' })}
          >{a.label}</a>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .hero { padding: 120px 0 24px; }
  .eyebrow { margin: 0; color: var(--color-accent); font-size: 0.9rem; }
  h1 { margin: 8px 0 0; font-size: clamp(2.25rem, 6vw, 3.5rem); line-height: 1.15; letter-spacing: -0.02em; }
  .tagline { margin: 16px 0 0; font-size: 1.2rem; max-width: 40ch; }
  blockquote { margin: 20px 0 0; padding-left: 14px; border-left: 3px solid var(--color-border); }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 32px; }
</style>
